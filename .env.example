# Google reCAPTCHA v3 Configuration
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdkaZQtAAAAAlkSLA78ABt5Xeo0EgbfLbeqHZWu
RECAPTCHA_SECRET_KEY=6LdkaZQtAAAAAN1Rv3rzeOLVDW-UBaQorE1VgReS

# Meta WhatsApp Business Cloud API Integration
# Enable / Disable automated messaging (true in production, false for local mock mode)
WHATSAPP_ENABLED=true

# Meta Graph API Version (default: v20.0)
WHATSAPP_API_VERSION=v20.0

# Meta System User Permanent Access Token (Generate in Meta Business Manager -> System Users -> Generate Token with whatsapp_business_messaging scope)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Meta WhatsApp Business Phone Number ID (From Meta WhatsApp App Dashboard -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Meta WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Clinic WhatsApp Recipient Number (with country code, e.g. 917780245307 for Dr. Suhail / Reception)
WHATSAPP_NOTIFY_NUMBER=917780245307

# Optional: Multiple Notification Recipients (comma-separated or JSON array)
# WHATSAPP_NOTIFY_NUMBERS=917780245307,919876543210

# Optional: Approved Meta Template Names (if sending template messages instead of session text)
# WHATSAPP_APPOINTMENT_TEMPLATE=new_appointment_request
# WHATSAPP_CALLBACK_TEMPLATE=new_callback_request
