# Redesign Dental Clinics - Environment Variables Template
# Copy this file to .env or .env.local and configure your credentials.
# NEVER commit real secrets to source control.

# Server Configuration
PORT=8000
NODE_ENV=production

# Google reCAPTCHA v3 Configuration
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_BYPASS_DEV=false

# Meta WhatsApp Business Cloud API Integration
WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_NOTIFY_NUMBER=
WHATSAPP_NOTIFY_NUMBERS=

# Optional: Meta WhatsApp Message Templates
WHATSAPP_APPOINTMENT_TEMPLATE=
WHATSAPP_CALLBACK_TEMPLATE=

# Optional: Server-side Email Delivery Integration
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CLINIC_OFFICIAL_EMAIL=redesigndental@gmail.com
